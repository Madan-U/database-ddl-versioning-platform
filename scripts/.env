# ==========================================
# SQL SERVER CONNECTION CREDENTIALS
# ==========================================
# The Windows or SQL account used to connect to the target servers
DDL_SQL_USERNAME=<user name>
DDL_SQL_PASSWORD=<password>

# The server where the DDL_Git_Sync_Logs table is located
CENTRAL_MGMT_SERVER=10.x.x.x
LOGGING_DB=<Your DB>

# ==========================================
# HASHICORP VAULT CONFIGURATION
# ==========================================
VAULT_URL=https://sre-nomad-vault.gpx.prod.angelone.in:8200
VAULT_API_PATH=/v1/kv/data/eac9c0cd600441a7af0d7c6ef8ddbccb/prod/secrets

# Vault AppRole Credentials
VAULT_ROLE_ID=your_approle_id_here
VAULT_SECRET_ID=your_approle_secret_id_here

# ==========================================
# GITHUB CONFIGURATION
# ==========================================
GITHUB_ORG=angel-one
GITHUB_REPO=backoffice_ddl_tracker
GIT_USER_NAME="DBA Automation Service"
GIT_USER_EMAIL="your service email"

# ==========================================
# LOCAL PATHS
# ==========================================
BASE_OUTPUT_DIR=C:\DDL_Automation\ddl_exports
SERVERS_FILE_PATH=C:\DDL_Automation\servers.txt
CENTRAL_LOG_DIR=C:\DDL_Automation\central_logs
